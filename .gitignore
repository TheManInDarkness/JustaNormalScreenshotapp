# --- Build output ------------------------------------------------------------
# Everything CMake and MSBuild generate. Regenerated by one configure + build,
# and CMakeCache.txt hard-codes absolute paths from whichever machine ran it,
# so committing it actively breaks the build for anyone else.
build/
build-*/
out/
cmake-build-*/

# --- Visual Studio / MSBuild per-user state -----------------------------------
.vs/
ipch/
*.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.aps          # resource-editor backup of app.rc

# --- CMake per-user state ------------------------------------------------------
CMakeUserPresets.json

# --- Local tool state ----------------------------------------------------------
# Personal permission allowlist; .claude/settings.json (no ".local") is the
# shareable one and is deliberately not ignored.
.claude/settings.local.json

# --- Windows shell junk --------------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini

# --- Stray artefacts -----------------------------------------------------------
# Nothing should write these into the tree, but past test runs have.
*.pdf
*.log
Screenshots_*.png

# --- Stray build/scratch artefacts --------------------------------------------
*.obj
last context.txt
consult_ans.txt

# --- Local accuracy corpus -----------------------------------------------------
# Real screen captures used by tools/OcrProbe for benchmarking. Deliberately
# not published (they are screenshots of the developer's own screen); see
# README, "Accuracy, honestly stated". Nothing in the build depends on this.
testassets/

# --- Large model blobs (see PUBLISHING.md section 0) --------------------------
# 213 MB of ONNX models + an 11 MB runtime DLL. Two of them are over GitHub's
# 50 MB warning threshold, and git history is permanent. Ship them as a
# Release attachment instead; the app falls back to Windows.Media.Ocr without
# them, so a clone with no models still builds and still runs.
# Delete these two lines if you deliberately choose to commit them.
third_party/ppocr/*.onnx
third_party/onnxruntime/onnxruntime.dll
