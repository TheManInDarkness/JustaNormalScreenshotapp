#include <windows.h>
#include <commctrl.h>
#include "Resource.h"

#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "manifest.xml"

IDI_APP_ICON ICON "app_icon.ico"

IDR_TRAY_MENU MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Capture Full Screen",  ID_TRAY_FULLSCREEN
        MENUITEM "Capture Window",       ID_TRAY_WINDOW
        MENUITEM "Capture Region",       ID_TRAY_REGION
        MENUITEM SEPARATOR
        MENUITEM "Stitch Images...",     ID_TRAY_STITCH
        MENUITEM SEPARATOR
        MENUITEM "Settings",             ID_TRAY_SETTINGS
        MENUITEM "Exit",                 ID_TRAY_EXIT
    END
END

IDD_SETTINGS DIALOGEX 0, 0, 350, 250
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Screenshot App Settings"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_TAB, WC_TABCONTROL, 0, 10,10,330,200
    DEFPUSHBUTTON "OK", IDOK, 220,220,50,14
    PUSHBUTTON "Cancel", IDCANCEL, 280,220,50,14
END

IDD_STITCH DIALOGEX 0, 0, 520, 410
STYLE WS_OVERLAPPEDWINDOW | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_THICKFRAME
CAPTION "Stitch Images & PDF Export"
FONT 9, "Segoe UI"
BEGIN
    LISTBOX IDC_IMAGE_LIST, 10,10,180,310, LBS_STANDARD | LBS_HASSTRINGS
    PUSHBUTTON "Add...", IDC_ADD_IMAGE, 10,325,40,14
    PUSHBUTTON "Remove", IDC_REMOVE_IMAGE, 55,325,40,14
    PUSHBUTTON "Up", IDC_MOVE_UP, 100,325,40,14
    PUSHBUTTON "Down", IDC_MOVE_DOWN, 145,325,40,14
    
    CONTROL "", IDC_PREVIEW, "Static", SS_BITMAP | SS_CENTERIMAGE | SS_SUNKEN, 200,10,300,200
    
    GROUPBOX "Orientation", IDC_STATIC, 200,215,140,30
    CONTROL "Vertical", IDC_RADIO_VERTICAL, "Button", BS_AUTORADIOBUTTON | WS_GROUP, 210,228,55,10
    CONTROL "Horizontal", IDC_RADIO_HORIZONTAL, "Button", BS_AUTORADIOBUTTON, 270,228,60,10
    
    CONTROL "Remove Overlap", IDC_CHECK_OVERLAP, "Button", BS_AUTOCHECKBOX, 350,225,120,10
    
    GROUPBOX "Alignment", IDC_STATIC, 200,250,270,30
    CONTROL "Left/Top", IDC_RADIO_LEFT, "Button", BS_AUTORADIOBUTTON | WS_GROUP, 210,263,60,10
    CONTROL "Center", IDC_RADIO_CENTER, "Button", BS_AUTORADIOBUTTON, 280,263,60,10
    CONTROL "Right/Bottom", IDC_RADIO_RIGHT, "Button", BS_AUTORADIOBUTTON, 350,263,80,10
    
    LTEXT "Gap (px):", IDC_STATIC, 200,290,40,10
    EDITTEXT IDC_GAP_EDIT, 245,288,40,12, ES_NUMBER
    
    GROUPBOX "Export Format", IDC_STATIC, 200,310,270,35
    CONTROL "PDF Document", IDC_RADIO_PDF, "Button", BS_AUTORADIOBUTTON | WS_GROUP, 210,325,80,10
    CONTROL "Image File", IDC_RADIO_IMAGE, "Button", BS_AUTORADIOBUTTON, 300,325,60,10
    CONTROL "Each image on own page", IDC_CHECK_PDF_PAGE, "Button", BS_AUTOCHECKBOX, 370,325,95,10
    
    DEFPUSHBUTTON "Stitch && Save", IDC_STITCH_SAVE, 310,375,90,16
    PUSHBUTTON "Copy Result", IDC_COPY_RESULT, 410,375,90,16
END
